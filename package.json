{
  "name": "yourlocalbusiness",
  "private": true,
  "version": "1.0.0",
  "description": "Yourlocalbusiness — AI-powered workspace to research, build, brand, list and market digital products and local businesses.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "server": "node server/ai-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/design-lint.mjs --strict && vitest run",
    "lint:design": "node scripts/design-lint.mjs --strict"
  },
  "dependencies": {
